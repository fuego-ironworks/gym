diff --git a/megatron/checkpointing.py b/megatron/checkpointing.py
index 0f17b0d..a75dbb2 100644
--- a/megatron/checkpointing.py
+++ b/megatron/checkpointing.py
@@ -194,6 +194,20 @@ def save_checkpoint(neox_args, iteration, model, optimizer, lr_scheduler):
 
     # Wait so everyone is done (necessary)
     torch.distributed.barrier()
+
+    # Dense reproduction checkpoints are analysis artifacts, not restart
+    # points. DeepSpeed still writes optimizer shards when NeoX's
+    # no_save_optim flag is set, so remove them only after every rank has
+    # completed the save. Publish an atomic ready marker last; the Gym upload
+    # worker ignores any checkpoint without this marker.
+    if neox_args.no_save_optim and torch.distributed.get_rank() == 0:
+        checkpoint_dir = Path(neox_args.save) / f"global_step{iteration}"
+        for optimizer_state in checkpoint_dir.rglob("*optim_states.pt"):
+            optimizer_state.unlink()
+        ready_tmp = checkpoint_dir / ".gym-ready.tmp"
+        ready_tmp.write_text(f"{iteration}\n")
+        os.replace(ready_tmp, checkpoint_dir / ".gym-ready")
+
     if neox_args.keep_last_n_checkpoints is not None:
         delete_old_checkpoints(neox_args.save, neox_args.keep_last_n_checkpoints)
 
