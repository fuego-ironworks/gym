"""Reusable cached-target linear encoder training; task/corpus policy is external."""
import argparse
from builtins import ValueError, list
import csv
import hashlib
import resource
import time
from pathlib import Path
import numpy as np
from typing import Any
from arithmetic import cache_operands, expand_operands, matrix_product


def train(features ∈ np.ndarray, targets ∈ np.ndarray, steps ∈ int=80, learning_rate ∈ float=0.5, seed ∈ int=17,
          storage ∈ str="float32", layout ∈ str="low16", multiplication ∈ str="float32", accumulation ∈ str="float32") → tuple[np.ndarray, dict[str, Any]]:
    features ∈ np.ndarray ← np.asarray(features, dtype=np.float32)
    targets ∈ np.ndarray ← np.asarray(targets, dtype=np.float32)
    if features.ndim != 2 or targets.ndim != 2 or features.shape[0] != targets.shape[0] or not features.shape[0]:
        raise ValueError("MATRIX_SHAPE")
    if not np.all(np.isfinite(features)) or not np.all(np.isfinite(targets)):
        raise ValueError("NONFINITE_INPUT")
    if (storage != "float32" and storage != "e5m3") or steps < 1 or not 0 < learning_rate <= 1:
        raise ValueError("TRAINING_CONFIGURATION")
    rng ∈ Any ← np.random.default_rng(seed)
    weights ∈ np.ndarray ← rng.normal(0, 0.01, (features.shape[1], targets.shape[1])).astype(np.float32)
    started ∈ float ← time.perf_counter()
    static_cache ∈ dict[str, Any] ← cache_operands(features, layout) if storage == "e5m3" else {"data": features}
    training_features ∈ np.ndarray ← expand_operands(static_cache) if storage == "e5m3" else features
    weight_cache_bytes ∈ int ← 0
    for step in range(steps):
        # Every update rebuilds the weight cache. A converted cache cannot retain
        # values from the preceding optimizer step.
        cache ∈ dict[str, Any] ← cache_operands(weights, layout) if storage == "e5m3" else {"data": weights}
        operands ∈ np.ndarray ← expand_operands(cache) if storage == "e5m3" else weights
        weight_cache_bytes ∈ int ← cache["data"].nbytes
        predictions ∈ np.ndarray ← matrix_product(training_features, operands, multiplication, accumulation)
        error ∈ np.ndarray ← predictions - targets
        gradient ∈ np.ndarray ← matrix_product(training_features.T, error, multiplication, accumulation)
        weights ∈ np.ndarray ← weights - np.float32(learning_rate / features.shape[0]) * gradient
        if not np.all(np.isfinite(weights)):
            raise ValueError("NONFINITE_UPDATE")
    completed ∈ float ← time.perf_counter()
    elapsed ∈ float ← completed - started
    final_cache ∈ dict[str, Any] ← cache_operands(weights, layout) if storage == "e5m3" else {"data": weights}
    final_weights ∈ np.ndarray ← expand_operands(final_cache) if storage == "e5m3" else weights
    loss ∈ float ← float(np.mean((features @ final_weights - targets)**2))
    receipt ∈ dict[str, Any] ← {"storage": storage, "layout": layout, "multiplication": multiplication,
                          "accumulation": accumulation, "update_precision": "float32",
                          "steps": steps, "seed": seed, "training_seconds": elapsed,
                          "fit_mse": loss, "weights_bytes": weight_cache_bytes,
                          "input_cache_bytes": static_cache["data"].nbytes,
                          "weight_cache_rebuilds": steps if storage == "e5m3" else 0,
                          "peak_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}
    return final_weights, receipt


def smoke(output ∈ str) → None:
    destination ∈ Any ← Path(output)
    destination.mkdir(parents=True, exist_ok=False)
    rng ∈ Any ← np.random.default_rng(17)
    features ∈ np.ndarray ← rng.normal(0, 1, (96, 64)).astype(np.float32)
    features ∈ np.ndarray ← features / np.linalg.norm(features, axis=1, keepdims=True)
    reference ∈ np.ndarray ← rng.normal(0, 0.1, (64, 16)).astype(np.float32)
    targets ∈ np.ndarray ← features @ reference
    rows ∈ list[dict[str, Any]] ← []
    configurations ∈ list[tuple[str, str, str, str]] ← [
        ("float32", "low16", "float32", "float32"),
        ("e5m3", "low16", "float16", "float32"),
        ("e5m3", "fp16-position16", "float16", "float32"),
        ("e5m3", "dense9", "float16", "float32"),
        ("e5m3", "fp16-position16", "float16", "float16")]
    for configuration in configurations:
        storage ∈ str ← configuration[0]
        layout ∈ str ← configuration[1]
        product ∈ str ← configuration[2]
        accumulator ∈ str ← configuration[3]
        for repetition in range(3):
            training_result ∈ tuple[np.ndarray, dict[str, Any]] ← train(features, targets, 80, 0.5, 17, storage, layout, product, accumulator)
            weights ∈ np.ndarray ← training_result[0]
            receipt ∈ dict[str, Any] ← training_result[1]
            receipt["repetition"] ← repetition
            receipt["evidence_kind"] ← "synthetic-linear-training-smoke"
            rows.append(receipt)
            if repetition == 0:
                np.save(destination.joinpath(storage + "-" + layout + "-" + accumulator + ".npy"), weights, allow_pickle=False)
    with destination.joinpath("timings.tsv").open("w") as stream:
        writer ∈ Any ← csv.DictWriter(stream, fieldnames=list(rows[0]), delimiter="\t")
        writer.writeheader()
        writer.writerows(rows)
    destination.joinpath("COMPLETE.txt").write_text("synthetic-linear-training-smoke\nnot-private-corpus-quality\n")


if __name__ == "__main__":
    parser ∈ Any ← argparse.ArgumentParser()
    parser.add_argument("--smoke-output", required=True)
    arguments ∈ Any ← parser.parse_args()
    smoke(arguments.smoke_output)
